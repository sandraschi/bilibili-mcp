# bilibili-mcp environment template. Copy to .env and fill in.
#
# Anonymous content-intelligence (explore, search, video, transcript) works
# with NO variables set. The account tier (following, favorites) needs a
# logged-in +86 Bilibili cookie.

# --- Account tier (OPTIONAL) --------------------------------------------------
# A logged-in +86 Bilibili SESSDATA cookie unlocks account tools and raises
# rate limits. Get this from docs/ONBOARDING.md - requires a Chinese +86
# account (e.g. CUniq / CMLink eSIM). Leave blank for anonymous mode.
# BILIBILI_COOKIE="SESSDATA=abc123;bili_jct=xyz;"

# --- Local LLM (OPTIONAL - powers /api/translate and /api/summarize) ----------
# Defaults to Ollama on localhost. Zero token cost (Local LLM First doctrine).
# BILIBILI_LLM_BASE_URL="http://127.0.0.1:11434/v1"
# BILIBILI_LLM_MODEL="qwen2.5:7b"

# --- Network / ports -----------------------------------------------------------
# BILIBILI_API_BASE="https://api.bilibili.com"
# BILIBILI_BACKEND_PORT="11185"
# BILIBILI_FRONTEND_PORT="11186"
# BILIBILI_CACHE_TTL="600"
